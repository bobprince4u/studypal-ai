# StudyPal frontend configuration.
#
# Copy to `.env.local` and adjust. Not required for local development — the
# default below is what the app falls back to when the variable is unset.

# Base URL of the StudyPal backend. No trailing slash; the app appends /api/...
# In a deployment this must be the public URL of the backend, and that same
# origin must be listed in the backend's FRONTEND_URL or CORS_ORIGINS.
NEXT_PUBLIC_API_URL=http://localhost:4000
