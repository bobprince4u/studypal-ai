{
  "name": "studypal-backend",
  "version": "1.0.0",
  "description": "API for StudyPal, an AI study companion for secondary school and university students",
  "keywords": [
    "studypal",
    "education",
    "express",
    "postgresql",
    "gemini"
  ],
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node scripts/migrate.mjs up",
    "migrate:status": "node scripts/migrate.mjs status",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:baseline": "node --test \"tests/baseline/**/*.test.js\"",
    "characterize": "node tests/characterize.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.46.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0"
  }
}
