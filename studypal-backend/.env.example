# StudyPal backend configuration.
#
# Copy to `.env` (or `.env.local`, which takes precedence) and fill in.
# Never commit the filled-in file — .gitignore already excludes both.
#
# Every variable below is optional except GEMINI_API_KEY. The defaults shown
# are the ones the server actually uses when the variable is unset.

# ── Required ────────────────────────────────────────────────────────────────

# Google AI Studio API key: https://aistudio.google.com/apikey
# Without it: POST /api/ask returns 500, POST /api/materials/chat returns 500,
# and uploaded materials are stored and readable but never indexed for search
# (`indexingStatus: "failed"`). Every other endpoint still works.
GEMINI_API_KEY=

# ── Server ──────────────────────────────────────────────────────────────────

# Port to listen on. Must be a number.
PORT=4000

# development | production | test. Enables HSTS and disables the
# localhost CORS allowance when set to `production`.
NODE_ENV=development

# error | warn | info | debug | silent
LOG_LEVEL=info

# ── CORS ────────────────────────────────────────────────────────────────────
#
# Leave BOTH unset and the API accepts requests from any origin, which is what
# it did before SP-V2-001 — convenient locally, too permissive in production.
# Set either one to restrict it. Outside NODE_ENV=production, localhost and
# 127.0.0.1 on any port are always allowed as well.

# The deployed frontend's origin, e.g. https://studypal.vercel.app
FRONTEND_URL=

# Additional allowed origins, comma-separated.
CORS_ORIGINS=

# ── Database ────────────────────────────────────────────────────────────────
#
# PostgreSQL is the only database. There is no file-based fallback: if
# DATABASE_URL is unset the server refuses to start.
#
# The `vector` extension (pgvector) is REQUIRED — migration 003 creates it and
# material_chunks.embedding depends on it. The official `postgres:16` images do
# not ship it, so compose.yaml uses `pgvector/pgvector:pg16`. A managed provider
# must have pgvector available (Neon, Supabase and RDS all do).
#
# For local development, `docker compose up -d` (see compose.yaml) starts
# PostgreSQL 16 with pgvector on 127.0.0.1:5434 using POSTGRES_* below.

# REQUIRED. postgresql://user:password@host:port/database
DATABASE_URL=postgresql://studypal:CHANGE_ME@127.0.0.1:5434/studypal

# REQUIRED to run the test suite. Must be a database that exists ONLY for
# tests — `npm test` recreates its schema on every run. It must have "test" in
# its name or the suite refuses to touch it, and DATABASE_URL is deliberately
# never used as a fallback here.
#   createdb studypal_test   (or see README for the docker compose one-liner)
STUDYPAL_TEST_DATABASE_URL=postgresql://studypal:CHANGE_ME@127.0.0.1:5434/studypal_test

# Credentials for the local docker compose container. compose.yaml reads these;
# `docker compose up` fails loudly if POSTGRES_PASSWORD is unset rather than
# defaulting to something guessable. Generate one, e.g.
#   printf 'POSTGRES_PASSWORD=dev_%s\n' "$(openssl rand -hex 12)" >> .env
POSTGRES_DB=studypal
POSTGRES_USER=studypal
POSTGRES_PASSWORD=

# Connection pool. One pool per process; never one connection per request.
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000

# TLS to the database. Off by default because local development connects over
# loopback to a container. Managed providers (Neon, Supabase, RDS) need `true`.
DB_SSL=false

# Only set to false for a provider presenting a self-signed certificate. It
# disables certificate verification, so TLS then protects against passive
# eavesdropping only, and the server logs a warning at startup.
DB_SSL_REJECT_UNAUTHORIZED=true

# ── Storage ─────────────────────────────────────────────────────────────────
#
# Where uploaded study materials are written. Local filesystem only in this
# iteration — S3 and other object storage are deferred (see
# docs/material-processing.md).

# Directory holding uploaded materials. A relative path is resolved against the
# backend directory, NOT the current working directory, so starting the server
# from somewhere else cannot split one deployment's uploads across two places.
# An absolute path is used as given, which is how a deployment points this at a
# mounted volume.
#
# The default is outside every source directory and is excluded by .gitignore,
# so uploaded documents can never be committed. Nothing is created when config
# is read; the storage service creates the directory the first time it writes.
#
# Under NODE_ENV=test this is ignored in favour of an isolated temporary
# directory per test server, so a test run cannot write into real uploads even
# if the harness forgets to set it.
STUDYPAL_STORAGE_DIR=./data/uploads

# ── AI ──────────────────────────────────────────────────────────────────────

GEMINI_MODEL=gemini-3-flash-preview

# Abort a generation after this many milliseconds. 0 = no timeout, which is the
# current default and matches the pre-refactor behaviour.
AI_TIMEOUT_MS=0

# ── RAG / semantic search ───────────────────────────────────────────────────
#
# Embeddings for POST /api/materials/chat. See docs/rag-architecture.md.
#
# READ THIS BEFORE CHANGING THE FIRST TWO. The model and the dimension define
# the vector space every stored embedding lives in. Change either one and the
# vectors already in material_chunks.embedding become incomparable with new
# ones — similarity search will still run and will return confident nonsense,
# because there is no way to detect it in the data. Changing them requires
# re-indexing every material (reindexMaterial in
# src/materials/material-indexing.service.js), and changing the dimension also
# requires a new migration to alter the column's width.

# The Google embedding model. `gemini-embedding-001` is chosen deliberately: it
# returns one vector per input string, whereas gemini-embedding-2 returns a
# single aggregated vector for a batch, which is wrong for per-chunk indexing.
STUDYPAL_EMBEDDING_MODEL=gemini-embedding-001

# Output dimension, 128-3072. MUST equal the width of the `vector(n)` column in
# migrations/postgres/003_material_embeddings.sql — 1536 — or every insert
# fails. 1536 rather than the model's native 3072 because pgvector's HNSW and
# IVFFlat indexes cap at 2000 dimensions, so 3072 would foreclose ever adding
# one; the model supports Matryoshka truncation, so 1536 is a supported output
# rather than a truncated 3072. The server logs a warning at startup if this
# does not match the migrated width.
STUDYPAL_EMBEDDING_DIM=1536

# Chunks sent to the embedding API per request. Sequential batches, no
# concurrency. Lower it if the provider rate-limits; 1 makes every chunk its own
# request.
STUDYPAL_EMBEDDING_BATCH_SIZE=32

# Chunks retrieved per question by default. Five ~1800-character chunks is
# roughly 9000 characters of context, which fits the budget below.
STUDYPAL_RAG_TOP_K=5

# The server's ceiling on a request's `topK`. A request asking for more gets
# this, not an error — the field is a hint, and the maximum is not negotiable.
STUDYPAL_RAG_MAX_TOP_K=20

# Minimum cosine similarity (0-1) for a chunk to count as relevant. Below it,
# retrieval returns nothing, the model is NOT called, and the endpoint answers
# "not covered by your materials".
#
# This is the value most worth tuning for a real corpus, and 0.5 is a starting
# point rather than a correct answer: too low admits irrelevant chunks and
# invites a confidently wrong answer, too high refuses questions the materials
# do cover. Retune it after changing the embedding model — thresholds do not
# transfer between vector spaces.
STUDYPAL_RAG_SIMILARITY_THRESHOLD=0.5

# Maximum characters of retrieved material placed in one prompt. Chunks past the
# budget are dropped in similarity order, so the least relevant go first, and a
# dropped chunk cannot be cited because it never reached the prompt.
STUDYPAL_RAG_MAX_CONTEXT_CHARS=12000

# Longest question POST /api/materials/chat accepts. Embedding models truncate
# their input, so a longer question would be billed for and then only partly
# searched — a 400 is more honest than an answer to the first 2000 characters.
STUDYPAL_RAG_MAX_QUESTION_CHARS=2000

# ── Limits ──────────────────────────────────────────────────────────────────

# Maximum size of a POST /api/ask attachment, in bytes. Default 10485760 (10 MB).
MAX_UPLOAD_BYTES=10485760

# Maximum size of a POST /api/materials upload, in bytes. Separate from
# MAX_UPLOAD_BYTES because the two endpoints do different work — an attachment
# is inlined into one prompt, a material is stored, extracted and chunked — so
# raising the limit for textbooks should not also raise it for prompts. Unset,
# it falls back to MAX_UPLOAD_BYTES, so the two are 10 MB together by default.
MAX_MATERIAL_BYTES=10485760

# Items returned by GET /api/materials
MATERIAL_LIST_LIMIT=100

# Longest original filename accepted by POST /api/materials. Matches the
# materials_original_filename_bounded CHECK constraint in
# migrations/postgres/002_materials.sql; the filename is metadata only and is
# never used as a filesystem path.
MAX_MATERIAL_FILENAME_LENGTH=512

# Maximum JSON request body. Accepts any `bytes` string, e.g. 100kb, 1mb.
JSON_BODY_LIMIT=100kb

MAX_USERNAME_LENGTH=200

# Items returned by GET /api/history/:username
HISTORY_LIMIT=30

# Topics returned by GET /api/progress/:username
PROGRESS_TOPICS_LIMIT=6

# Characters of extracted document text forwarded to the model by POST /api/ask.
# Unrelated to material chunking: chunk size and overlap are deliberately NOT
# environment variables, because changing them changes what is already stored.
# They are named constants in src/materials/text-chunker.js.
DOCUMENT_TEXT_CHARS=4000
